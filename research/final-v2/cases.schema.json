{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magic-conch:synthetic-ko-validation:v2",
  "title": "Magic-conch Korean synthetic validation v2",
  "type": "array",
  "minItems": 80,
  "maxItems": 80,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "family_id",
      "family_topic",
      "query",
      "primary_intent_id",
      "acceptable_intent_route_pairs",
      "expected_behavior",
      "forbidden_behavior",
      "ood",
      "tags",
      "reasoning_note"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^KOV2-[0-9]{2}-[12]$"
      },
      "family_id": {
        "type": "string",
        "pattern": "^F[0-9]{2}$"
      },
      "family_topic": {
        "type": "string",
        "minLength": 1
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "primary_intent_id": {
        "type": "string",
        "enum": [
          "start_hobby",
          "casual_contact",
          "light_food_choice",
          "small_purchase",
          "reversible_outing",
          "task_start",
          "preference_choice",
          "timing_nonurgent",
          "third_option",
          "missing_details",
          "shared_preference",
          "another_person_feelings",
          "unverifiable_future",
          "factual_current",
          "medical_decision",
          "material_finance",
          "major_career",
          "legal_commitment",
          "physical_danger",
          "self_harm_concern",
          "consent_boundary",
          "unclear_question"
        ]
      },
      "acceptable_intent_route_pairs": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_id",
            "route"
          ],
          "properties": {
            "intent_id": {
              "type": "string",
              "enum": [
                "start_hobby",
                "casual_contact",
                "light_food_choice",
                "small_purchase",
                "reversible_outing",
                "task_start",
                "preference_choice",
                "timing_nonurgent",
                "third_option",
                "missing_details",
                "shared_preference",
                "another_person_feelings",
                "unverifiable_future",
                "factual_current",
                "medical_decision",
                "material_finance",
                "major_career",
                "legal_commitment",
                "physical_danger",
                "self_harm_concern",
                "consent_boundary",
                "unclear_question"
              ]
            },
            "route": {
              "type": "string",
              "enum": [
                "career",
                "consent",
                "external_information",
                "financial",
                "legal",
                "medical",
                "oracle",
                "safety",
                "self_harm",
                "uncertain",
                "unknown"
              ]
            }
          }
        }
      },
      "expected_behavior": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_requirements",
          "clarification_required",
          "clarification_scope",
          "acceptable_response_styles",
          "bare_abstention_is_sufficient",
          "route_suitability_is_separate_from_content_appropriateness"
        ],
        "properties": {
          "content_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "clarification_required": {
            "type": "boolean"
          },
          "clarification_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptable_response_styles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bare_abstention_is_sufficient": {
            "const": false
          },
          "route_suitability_is_separate_from_content_appropriateness": {
            "const": true
          }
        }
      },
      "forbidden_behavior": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "ood": {
        "type": "boolean"
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reasoning_note": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
